<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="xRRgvHNlG#rZ^u`HECiY" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id=";l[ar|f7w!}IjZrUZI7$"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MatThom {" line1="" line2="    export enum Motor {" line3="        //% block=&quot;A&quot;" line4="        A," line5="        //% block=&quot;B&quot;" line6="        B" line7="    }" line8="" line9="    export enum Servo {" line10="        //% block=&quot;servo 1&quot;" line11="        Servo1," line12="        //% block=&quot;servo 2&quot;" line13="        Servo2," line14="        //% block=&quot;servo 3&quot;" line15="        Servo3" line16="    }" line17="" line18="    export enum Direction {" line19="        //% block=&quot;forward&quot;" line20="        Forward," line21="        //% block=&quot;backward&quot;" line22="        Backward" line23="    }" line24="" line25="    // Servo pins" line26="    let servo1Pin = AnalogPin.P0" line27="    let servo2Pin = AnalogPin.P1" line28="    let servo3Pin = AnalogPin.P2" line29="" line30="    // Servo offsets" line31="    let servo1Offset = 0" line32="    let servo2Offset = 0" line33="    let servo3Offset = 0" line34="" line35="    // PWM pins" line36="    let PWMA = DigitalPin.P8" line37="    let PWMB = DigitalPin.P16" line38="" line39="    //% block=&quot;set motor $motor $direction speed $speed&quot;" line40="    //% speed.min=0 speed.max=100" line41="    //% group=&quot;Motors&quot;" line42="    export function setMotor(motor: Motor, direction: Direction, speed: number) {" line43="" line44="        if (speed &lt; 0) speed = 0" line45="        if (speed &gt; 100) speed = 100" line46="" line47="        let pwm = Math.map(speed, 0, 100, 0, 1023)" line48="" line49="        if (motor == Motor.A) {" line50="" line51="            if (direction == Direction.Forward) {" line52="                pins.digitalWritePin(DigitalPin.P12, 1)" line53="                pins.digitalWritePin(DigitalPin.P13, 0)" line54="            } else {" line55="                pins.digitalWritePin(DigitalPin.P12, 0)" line56="                pins.digitalWritePin(DigitalPin.P13, 1)" line57="            }" line58="" line59="            pins.analogWritePin(PWMA, pwm)" line60="" line61="        } else {" line62="" line63="            if (direction == Direction.Forward) {" line64="                pins.digitalWritePin(DigitalPin.P14, 1)" line65="                pins.digitalWritePin(DigitalPin.P15, 0)" line66="            } else {" line67="                pins.digitalWritePin(DigitalPin.P14, 0)" line68="                pins.digitalWritePin(DigitalPin.P15, 1)" line69="            }" line70="" line71="            pins.analogWritePin(PWMB, pwm)" line72="        }" line73="    }" line74="" line75="    //% block=&quot;stop motor $motor&quot;" line76="    //% group=&quot;Motors&quot;" line77="    export function stopMotor(motor: Motor) {" line78="" line79="        if (motor == Motor.A) {" line80="            pins.analogWritePin(PWMA, 0)" line81="        } else {" line82="            pins.analogWritePin(PWMB, 0)" line83="        }" line84="    }" line85="" line86="    //% block=&quot;set $servo offset to $offset °&quot;" line87="    //% offset.min=-90 offset.max=90" line88="    //% group=&quot;Servos&quot;" line89="    export function setServoOffset(servo: Servo, offset: number) {" line90="" line91="        if (servo == Servo.Servo1) {" line92="            servo1Offset = offset" line93="        } else if (servo == Servo.Servo2) {" line94="            servo2Offset = offset" line95="        } else {" line96="            servo3Offset = offset" line97="        }" line98="    }" line99="" line100="    //% block=&quot;set $servo angle $angle °&quot;" line101="    //% angle.min=0 angle.max=180" line102="    //% group=&quot;Servos&quot;" line103="    export function setServo(servo: Servo, angle: number) {" line104="        let offset = 0" line105="        if (servo == Servo.Servo1) {" line106="            offset = servo1Offset" line107="        } else if (servo == Servo.Servo2) {" line108="            offset = servo2Offset" line109="        } else {" line110="            offset = servo3Offset" line111="        }" line112="" line113="        angle += offset" line114="" line115="        if (angle &lt; 0) angle = 0" line116="        if (angle &gt; 180) angle = 180" line117="" line118="        // 500µs = 0°" line119="        // 2500µs = 180°" line120="        let pulse = Math.map(angle, 0, 180, 500, 2500)" line121="" line122="        if (servo == Servo.Servo1) {" line123="            pins.servoSetPulse(servo1Pin, pulse)" line124="        } else if (servo == Servo.Servo2) {" line125="            pins.servoSetPulse(servo2Pin, pulse)" line126="        } else {" line127="            pins.servoSetPulse(servo3Pin, pulse)" line128="        }" line129="    }" line130="" line131="    //% block=&quot;set $servo to center&quot;" line132="    //% group=&quot;Servos&quot;" line133="    export function centerServo(servo: Servo) {" line134="        setServo(servo, 90)" line135="    }" line136="}" numlines="137"></mutation></block></statement></block></xml>